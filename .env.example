# ───────────────────────────────────────────────────────────────────────────
# TwinForge AI — environment configuration
# Everything is OPTIONAL. With no variables set, the demo runs fully offline:
# simulated telemetry, deterministic agents, local persistence and documents.
# Never commit real secrets. Server-side only — nothing here reaches the browser.
# ───────────────────────────────────────────────────────────────────────────

# ── Nebius Token Factory & NVIDIA Nemotron (Primary Provider) ───────────────
# API key from Nebius Token Factory / Nebius AI Cloud
NEBIUS_API_KEY=
# NVIDIA model served on Nebius Token Factory (default: nvidia/llama-3.1-nemotron-70b-instruct)
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Nebius Token Factory OpenAI-compatible endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# ── Tavily Web Search API (Grounding & Supply Chain Research) ───────────────
# Powers real-time BOM component stock queries and IPC-A-610 standards lookup
TAVILY_API_KEY=

# ── AI Provider Selection ───────────────────────────────────────────────────
# nebius | openai-compatible | anthropic | openai | gemini-api | vertex
AI_PROVIDER=nebius
AI_ENABLED=true
AI_TIMEOUT_MS=30000

# ── BigQuery (scenario outcomes & decisions are mirrored when set) ──────────
# Create tables with infra/bigquery/schema.sql
BIGQUERY_DATASET=

# ── Pub/Sub telemetry ingestion ─────────────────────────────────────────────
# Messages: {"assetId":"A-ROB-03","vibration":7.4,"temperature":79.1,"powerKw":8.6}
PUBSUB_TELEMETRY_SUBSCRIPTION=
# "simulated" (default) or "pubsub" to let Pub/Sub readings override simulated measurements
TELEMETRY_SOURCE=simulated

# ── Cloud Storage documents (objects under assets/<assetId>/) ───────────────
GCS_BUCKET=

# ── MQTT (reachability probe only in this MVP) ──────────────────────────────
MQTT_BROKER_URL=
MQTT_TOPIC=

# ── Python vision service (services/vision: FastAPI + OpenCV) ───────────────
# Local: cd services/vision && uv run uvicorn app.main:app --port 8000  →  http://localhost:8000
# Cloud Run: the service URL; requests carry a Google ID token (grant roles/run.invoker).
VISION_SERVICE_URL=

# ── Persistence ─────────────────────────────────────────────────────────────
# Directory for the local JSON state file (default ./.data; Cloud Run image uses /tmp/twinforge)
TWINFORGE_DATA_DIR=

# ── Admin & settings from the UI ────────────────────────────────────────────
# Every integration above can also be set on the Integrations page (admin); a value saved there
# overrides the variable here. Saved settings go to <data dir>/settings.json, or to this private
# Cloud Storage bucket when set (durable across Cloud Run instance restarts).
TWINFORGE_CONFIG_BUCKET=
# Admin passcode for camera sources and integration settings. Without it, admin is open in local
# development and disabled on Cloud Run. Use Secret Manager in production, never a committed value.
TWINFORGE_ADMIN_KEY=

# ── MCP server (/api/mcp) ────────────────────────────────────────────────────
# Optional bearer token for external agents; can also be set or turned off on the Integrations page.
TWINFORGE_MCP_TOKEN=

# ── AI provider (also selectable on Integrations → AI model provider) ────────
# vertex | gemini-api | anthropic | openai | openai-compatible. Without it, Vertex AI is used when
# GOOGLE_CLOUD_PROJECT is set, else the Gemini API when GEMINI_API_KEY is set.
AI_PROVIDER=
# Turn every AI call off (deterministic narratives, template-mode Twin Builder, no copilot).
AI_ENABLED=
# Claude: an Anthropic API key (billed separately from Claude Pro/Max subscriptions).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# OpenAI, or an OpenAI-compatible endpoint (OpenRouter, Groq, a local Ollama at http://localhost:11434/v1)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
